import requests  # Import the requests library to make HTTP requests

def health_check(url):
    try:
        # Send a GET request to the URL provided
        response = requests.get(url)

        # Check if the HTTP status code is 200 (OK)
        if response.status_code == 200:
            print(f"Website {url} is up and running!")  # If status is 200, the website is healthy
        else:
            print(f"Website {url} returned status code {response.status_code}.")  # If not 200, print status code
    except requests.exceptions.RequestException as e:
        # If there was an exception while making the request (e.g., network error), print the error
        print(f"Failed to reach {url}. Error: {e}")

# Example usage
url = 'https://www.example.com'  # URL of the website to check
health_check(url)  # Call the function to check the website health