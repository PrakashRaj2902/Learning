import boto3

def lambda_handler(event, context):
    # Initialize the EC2 client
    ec2 = boto3.client('ec2')
    
    # Get instance ID from the CloudWatch alarm SNS notification (or event)
    # Assuming the alarm sends the Instance ID in the 'Trigger' field
    instance_id = event['Records'][0]['Sns']['MessageAttributes']['InstanceID']['Value']
    
    print(f"Detected issue on instance: {instance_id}")

    # Attempt to restart the instance
    try:
        print(f"Restarting instance: {instance_id}")
        
        # Stop the instance (you can also just reboot the instance if you prefer)
        ec2.reboot_instances(InstanceIds=[instance_id])

        print(f"Successfully restarted instance: {instance_id}")
    
    except Exception as e:
        print(f"Error restarting instance {instance_id}: {e}")
        raise e
