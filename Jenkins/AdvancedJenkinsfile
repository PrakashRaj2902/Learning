pipeline {

    /*
     * agent
     * Where Jenkins executes the pipeline.
     * In real projects this could be a static agent, Docker agent,
     * Kubernetes agent, or dynamically provisioned agent.
     */
    agent any


    /*
     * tools
     * Tells Jenkins which pre-configured tool versions to use.
     * These tools must already be configured in Jenkins.
     */
    tools {
        maven 'Maven-3.9'
        jdk 'JDK-17'
    }


    /*
     * parameters
     * Allows user to provide values when starting the pipeline.
     */
    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'qa', 'prod'],
            description: 'Select deployment environment'
        )

        string(
            name: 'IMAGE_TAG',
            defaultValue: '',
            description: 'Docker image tag. Leave empty to use BUILD_NUMBER'
        )

        booleanParam(
            name: 'DEPLOY',
            defaultValue: true,
            description: 'Deploy application to Kubernetes?'
        )
    }


    /*
     * environment
     * Global environment variables available throughout the pipeline.
     */
    environment {

        APP_NAME = 'payment-service'

        AWS_REGION = 'ap-south-1'

        ECR_REPO = '123456789012.dkr.ecr.ap-south-1.amazonaws.com/payment-service'

        NEXUS_URL = 'https://nexus.company.com'

        K8S_NAMESPACE = 'payment'

        HELM_RELEASE = 'payment-service'

        HELM_CHART = './helm/payment-service'

        /*
         * Credentials are referenced by ID.
         * Actual secret value is NOT stored in Jenkinsfile.
         */
        NEXUS_CREDENTIALS = credentials('nexus-credentials')

        AWS_CREDENTIALS = credentials('aws-deployment-role')
    }


    /*
     * options
     * Pipeline-level behaviour.
     */
    options {

        // Don't allow two executions of same job simultaneously.
        disableConcurrentBuilds()

        // Stop pipeline if it runs longer than 60 minutes.
        timeout(time: 60, unit: 'MINUTES')

        // Keep only last 10 builds.
        buildDiscarder(
            logRotator(
                numToKeepStr: '10'
            )
        )

        // Add timestamps to console logs.
        timestamps()

        // Preserve stashes if needed.
        preserveStashes(buildCount: 5)

        // Skip automatic checkout because we explicitly control checkout.
        skipDefaultCheckout(true)
    }


    stages {


        // =========================================================
        // 1. CHECKOUT
        // =========================================================

        stage('Checkout') {

            steps {

                checkout scm

                sh '''
                    echo "Branch: ${BRANCH_NAME}"
                    echo "Commit: $(git rev-parse --short HEAD)"
                '''
            }
        }


        // =========================================================
        // 2. BUILD
        // =========================================================

        stage('Build') {

            steps {

                sh '''
                    mvn clean compile
                '''
            }
        }


        // =========================================================
        // 3. UNIT TEST
        // =========================================================

        stage('Unit Test') {

            steps {

                sh '''
                    mvn test
                '''
            }

            post {

                always {

                    /*
                     * Publish JUnit test results even when tests fail.
                     */
                    junit(
                        testResults: '**/target/surefire-reports/*.xml',
                        allowEmptyResults: true
                    )
                }
            }
        }


        // =========================================================
        // 4. CODE QUALITY
        // =========================================================

        stage('SonarQube Analysis') {

            steps {

                /*
                 * SonarQube environment configuration
                 * is managed in Jenkins.
                 */
                withSonarQubeEnv('SonarQube-Server') {

                    sh '''
                        mvn sonar:sonar
                    '''
                }
            }
        }


        // =========================================================
        // 5. QUALITY GATE
        // =========================================================

        stage('Quality Gate') {

            steps {

                /*
                 * Wait for SonarQube quality gate result.
                 *
                 * timeout prevents Jenkins waiting forever.
                 */
                timeout(time: 5, unit: 'MINUTES') {

                    waitForQualityGate(
                        abortPipeline: true
                    )
                }
            }
        }


        // =========================================================
        // 6. PACKAGE JAR
        // =========================================================

        stage('Package') {

            steps {

                sh '''
                    mvn package -DskipTests
                '''

                /*
                 * Save JAR for later stages/build records.
                 */
                archiveArtifacts(
                    artifacts: 'target/*.jar',
                    fingerprint: true
                )

                /*
                 * Stash JAR so another agent could use it later.
                 */
                stash(
                    name: 'application-jar',
                    includes: 'target/*.jar'
                )
            }
        }


        // =========================================================
        // 7. DEPENDENCY SECURITY SCAN
        // =========================================================

        stage('Dependency Security Scan') {

            steps {

                /*
                 * Example only.
                 * Actual organization may use Snyk,
                 * OWASP Dependency-Check, Mend etc.
                 */

                sh '''
                    echo "Running dependency vulnerability scan..."

                    # Example:
                    # mvn org.owasp:dependency-check-maven:check
                '''
            }
        }


        // =========================================================
        // 8. UPLOAD JAR TO NEXUS
        // =========================================================

        stage('Publish Artifact to Nexus') {

            steps {

                /*
                 * Nexus stores versioned application artifacts.
                 */

                withCredentials([
                    usernamePassword(
                        credentialsId: 'nexus-credentials',
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASSWORD'
                    )
                ]) {

                    sh '''
                        echo "Uploading JAR to Nexus..."

                        curl -u "$NEXUS_USER:$NEXUS_PASSWORD" \
                        --upload-file target/${APP_NAME}.jar \
                        ${NEXUS_URL}/repository/releases/${APP_NAME}/${BUILD_NUMBER}/${APP_NAME}-${BUILD_NUMBER}.jar
                    '''
                }
            }
        }


        // =========================================================
        // 9. DOCKER BUILD
        // =========================================================

        stage('Docker Build') {

            steps {

                script {

                    /*
                     * If IMAGE_TAG parameter is empty,
                     * use Jenkins BUILD_NUMBER.
                     */
                    env.IMAGE_TAG =
                        params.IMAGE_TAG?.trim()
                        ? params.IMAGE_TAG.trim()
                        : env.BUILD_NUMBER

                    echo "Building image: ${ECR_REPO}:${IMAGE_TAG}"

                    sh """
                        docker build \
                        -t ${ECR_REPO}:${IMAGE_TAG} .
                    """
                }
            }
        }


        // =========================================================
        // 10. CONTAINER SECURITY SCAN
        // =========================================================

        stage('Container Security Scan') {

            steps {

                sh """
                    echo "Scanning Docker image..."

                    # Example:
                    # trivy image --exit-code 1 ${ECR_REPO}:${IMAGE_TAG}
                """
            }
        }


        // =========================================================
        // 11. PUSH IMAGE TO ECR
        // =========================================================

        stage('Push Image to ECR') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'aws-deployment-role'
                    ]
                ]) {

                    sh """
                        aws ecr get-login-password \
                        --region ${AWS_REGION} |
                        docker login \
                        --username AWS \
                        --password-stdin ${ECR_REPO}

                        docker push ${ECR_REPO}:${IMAGE_TAG}
                    """
                }
            }
        }


        // =========================================================
        // 12. DEPLOY TO KUBERNETES
        // =========================================================

        stage('Deploy to Kubernetes') {

            when {

                expression {
                    return params.DEPLOY
                }
            }

            steps {

                script {

                    /*
                     * Retry is useful for transient deployment failures.
                     */
                    retry(2) {

                        sh """
                            helm upgrade --install ${HELM_RELEASE} \
                            ${HELM_CHART} \
                            --namespace ${K8S_NAMESPACE} \
                            --create-namespace \
                            --set image.repository=${ECR_REPO} \
                            --set image.tag=${IMAGE_TAG}
                        """
                    }
                }
            }
        }


        // =========================================================
        // 13. ROLLOUT STATUS
        // =========================================================

        stage('Verify Deployment') {

            steps {

                script {

                    try {

                        sh """
                            kubectl rollout status \
                            deployment/${APP_NAME} \
                            -n ${K8S_NAMESPACE} \
                            --timeout=180s
                        """

                    } catch (Exception e) {

                        echo "Deployment verification failed."

                        /*
                         * Rollback automatically.
                         */
                        sh """
                            kubectl rollout undo \
                            deployment/${APP_NAME} \
                            -n ${K8S_NAMESPACE}
                        """

                        /*
                         * Re-throw error so Jenkins marks build failed.
                         */
                        throw e
                    }
                }
            }
        }


        // =========================================================
        // 14. SMOKE TEST
        // =========================================================

        stage('Smoke Test') {

            steps {

                retry(3) {

                    sh '''
                        echo "Running application health check..."

                        # Example:
                        # curl -f https://payment.company.com/actuator/health
                    '''
                }
            }
        }
    }


    // =============================================================
    // POST
    // =============================================================

    post {

        success {

            echo """
            ==========================================
            PIPELINE SUCCESS
            Application : ${APP_NAME}
            Environment : ${params.ENVIRONMENT}
            Image       : ${IMAGE_TAG}
            Build       : ${BUILD_NUMBER}
            ==========================================
            """
        }

        failure {

            echo """
            ==========================================
            PIPELINE FAILED
            Application : ${APP_NAME}
            Build       : ${BUILD_NUMBER}
            Check Jenkins console logs.
            ==========================================
            """
        }

        unstable {

            echo 'Pipeline completed but is UNSTABLE.'
        }

        aborted {

            echo 'Pipeline was manually aborted.'
        }

        always {

            echo 'Pipeline execution completed.'

            /*
             * Cleanup workspace.
             */
            cleanWs()
        }
    }
}
